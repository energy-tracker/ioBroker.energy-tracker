{
    "name": "iobroker.energy-tracker",
    "version": "0.4.0",
    "description": "Adapter for sending meter readings with the Energy Tracker platform.",
    "author": "energy-tracker <support@energy-tracker.app>",
    "contributors": [
        "energy-tracker <support@energy-tracker.app>"
    ],
    "homepage": "https://github.com/energy-tracker/ioBroker.energy-tracker",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "energy tracker",
        "meter readings",
        "power consumption",
        "rest api"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/energy-tracker/ioBroker.energy-tracker.git"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@energy-tracker/api-client": "^1.0.2",
        "@iobroker/adapter-core": "^3.4.3",
        "decimal.js": "^10.6.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.0",
        "@tsconfig/node22": "^22.0.6",
        "@types/iobroker": "npm:@iobroker/types@^7.0.7",
        "@types/node": "^22.20.4",
        "@types/proxyquire": "^1.3.31",
        "npm-check-updates": "^23.1.0",
        "proxyquire": "^2.1.3",
        "rimraf": "^6.1.2",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "~5.8.3"
    },
    "main": "build/main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "build/",
        "www/",
        "io-package.json",
        "CHANGELOG_OLD.md",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf ./build",
        "build": "tsc -p tsconfig.build.json",
        "build:ts": "tsc -p tsconfig.build.json",
        "test": "npm run test:ts && npm run test:package",
        "test:ts": "mocha --config test/mocharc.custom.json src/**/*.spec.ts",
        "test:package": "mocha test/package --exit",
        "test:integration": "mocha test/integration --exit",
        "check": "tsc --noEmit",
        "format": "prettier --ignore-path .gitignore --write . \"!build/**\"",
        "format:check": "prettier --ignore-path .gitignore --check . \"!build/**\"",
        "lint": "eslint --ext .ts src/",
        "translate": "translate-adapter",
        "release": "release-script",
        "release:patch": "release-script patch --yes",
        "release:minor": "release-script minor --yes",
        "release:major": "release-script major --yes"
    },
    "bugs": {
        "url": "https://github.com/energy-tracker/ioBroker.energy-tracker/issues"
    },
    "readmeFilename": "README.md"
}
